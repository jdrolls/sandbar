#!/usr/bin/with-contenv bash
# The shared-seat browser is deliberately a separate s6 service: it owns one
# headed Chromium, while the Node bridge only attaches over container loopback.
set -euo pipefail
set -f # CHROMIUM_FLAGS is inspected, never shell-expanded into launch arguments.

# Keep this service inert for byte-compatible legacy seats. A sleeping service
# avoids s6 restart churn while starting no browser or listener.
if [[ "${SANDBAR_SHARED_BROWSER:-}" != "1" ]]; then
  exec sleep infinity
fi

if [[ "${SANDBAR_BROWSER_SANDBOX:-}" != "namespace" ]]; then
  printf '%s\n' "SANDBAR_SHARED_BROWSER=1 requires SANDBAR_BROWSER_SANDBOX=namespace." >&2
  exit 1
fi

# Never inherit launcher arguments into the fixed CDP process. Rejecting known
# sandbox-disabling flags also makes a poisoned persisted environment fail loud.
for sandbar_chromium_flag in ${CHROMIUM_FLAGS:-}; do
  case "$sandbar_chromium_flag" in
    --no-sandbox|--no-sandbox=*|--disable-setuid-sandbox|--disable-setuid-sandbox=*|--disable-namespace-sandbox|--disable-namespace-sandbox=*|--disable-seccomp-filter-sandbox|--disable-seccomp-filter-sandbox=*|--disable-gpu-sandbox|--disable-gpu-sandbox=*|--disable-landlock-sandbox|--disable-landlock-sandbox=*|--no-zygote-sandbox|--no-zygote-sandbox=*|--single-process|--single-process=*)
      printf '%s\n' "Sandbar shared browser refuses sandbox-disabling Chromium flags." >&2
      exit 1
      ;;
  esac
done

until DISPLAY=:1 xdotool getdisplaygeometry >/dev/null 2>&1 \
  && pgrep -u abc xfce4-session >/dev/null 2>&1; do
  sleep 1
done

# Do not silently add a second persistent browser after a service restart.
if pgrep -u abc -x chromium >/dev/null 2>&1; then
  printf '%s\n' "Sandbar shared browser found an existing abc Chromium process." >&2
  exit 1
fi

# The persistent profile may contain browser session state; do not inherit the
# volume's default directory mode or leave it readable by other container users.
install -d -m 0700 -o abc -g abc /config/sandbar-browser
chromium_bin="$(command -v chromium)"
if [[ -z "$chromium_bin" ]]; then
  printf '%s\n' "Sandbar shared browser cannot find Chromium." >&2
  exit 1
fi

# Session restore keeps each tab's form state (typed usernames and one-time
# codes, never passwords) on disk, and after an unclean exit Chromium offers to
# restore it. Start every browser with no stored session, and never show the
# crash-restore bubble. Chromium 156 writes Sessions/ and Sessions_Encrypted/;
# the older single-file names are removed too in case a profile still has
# them. This runs as abc, so a path planted in the profile cannot steer a root
# removal.
s6-setuidgid abc rm -rf -- \
  /config/sandbar-browser/Default/Sessions \
  /config/sandbar-browser/Default/Sessions_Encrypted \
  "/config/sandbar-browser/Default/Current Session" \
  "/config/sandbar-browser/Default/Current Tabs" \
  "/config/sandbar-browser/Default/Last Session" \
  "/config/sandbar-browser/Default/Last Tabs"

# An operator who signs this seat in to sites that offer passkeys first (Google)
# can turn WebAuthn off, so the site falls back to a password the seat can type
# instead of opening a native security-key prompt nobody can see or dismiss.
# Any value other than on or off fails loud rather than guessing.
webauthn_flags=()
case "${SANDBAR_BROWSER_WEBAUTHN:-on}" in
  on) ;;
  off) webauthn_flags=(--disable-blink-features=WebAuth) ;;
  *)
    printf "%s\n" "SANDBAR_BROWSER_WEBAUTHN must be on or off." >&2
    exit 1
    ;;
esac

exec s6-setuidgid abc env HOME=/config DISPLAY=:1 "$chromium_bin" \
  --user-data-dir=/config/sandbar-browser \
  --remote-debugging-address=127.0.0.1 \
  --remote-debugging-port=9222 \
  --no-first-run \
  --no-default-browser-check \
  --hide-crash-restore-bubble \
  "${webauthn_flags[@]}"
